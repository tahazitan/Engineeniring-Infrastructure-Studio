# Copy to .env (for Docker Compose + Next.js) and set local-only values
STUDIO_MODE=private
DATABASE_URL=postgresql://studio:change-this-for-local-use@127.0.0.1:5434/studio
POSTGRES_PASSWORD=change-this-for-local-use
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=studioadmin
MINIO_SECRET_KEY=change-this-storage-password
MINIO_BUCKET=studio-evidence

# Local Linux VM lab runner reached through an SSH tunnel on macOS.
LAB_RUNNER_URL=http://127.0.0.1:4401
# Set a unique random value (at least 32 characters) in .env on Mac and in VM runner environment.
LAB_RUNNER_TOKEN=replace-with-a-random-64-character-hex-token
